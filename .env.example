# העתיקי את הקובץ הזה לקובץ בשם .env ומלאי את הערכים.
# את הקובץ .env לא מעלים ל־GitHub (הוא כבר מופיע ב־.gitignore).

# כתובת מסד הנתונים (PostgreSQL). מקבלים אותה מספק מסד הנתונים, למשל Neon.
# בענן בדרך כלל מסתיימת ב־?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# רשות: מסד נתונים נפרד לבדיקות האוטומטיות (npm test). הבדיקות מוחקות את כל הנתונים בו!
# אף פעם לא לשים כאן את מסד הנתונים האמיתי.
TEST_DATABASE_URL=""

# מפתח סודי לחתימת ה־Token. מחרוזת אקראית ארוכה (לפחות 32 תווים).
# אפשר ליצור כזו בפקודה: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# כמה זמן Token בתוקף (למשל 8h = שמונה שעות)
JWT_EXPIRES_IN="8h"

# הפורט שהשרת מאזין לו. בענן הוא נקבע אוטומטית.
PORT=3000

# development במחשב שלך, production בענן
NODE_ENV="development"

# מאילו כתובות מותר לאתר ה־React לפנות לשרת. כמה כתובות - מפרידים בפסיק.
# במחשב: http://localhost:5173  |  בענן: הכתובת של אתר ה־React
CORS_ORIGINS="http://localhost:5173"

# סיסמה לחשבונות ההדגמה (מנהלת, מורות ותלמידות לדוגמה).
# במחשב אפשר להשאיר ריק - ייקבעו סיסמאות ההדגמה שמופיעות ב־README.
# בענן חובה לקבוע סיסמה משלך (לפחות 8 תווים), אחרת נתוני ההדגמה לא ייווצרו.
SEED_DEMO_PASSWORD=""

# בענן: true = אם מסד הנתונים ריק, למלא אותו בנתוני ההדגמה בהפעלה הראשונה.
SEED_ON_START="true"
